{
  "name": "@hubzz/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Public Hubzz design system and shadcn/ui registry.",
  "license": "MIT",
  "keywords": [
    "hubzz",
    "shadcn",
    "radix-ui",
    "react",
    "tailwindcss",
    "design-system",
    "ui",
    "components"
  ],
  "homepage": "https://hubzz.xyz/cn/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russfranky/hubzzcn.git"
  },
  "bugs": {
    "url": "https://github.com/russfranky/hubzzcn/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.33.4",
  "main": "./dist/hubzz-ui.cjs",
  "module": "./dist/hubzz-ui.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/hubzz-ui.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/hubzz-ui.cjs"
      }
    },
    "./styles.css": "./dist/hubzz-ui.css",
    "./dist/hubzz-ui.css": "./dist/hubzz-ui.css",
    "./components.json": "./dist/components.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/COMPONENTS.md"
  ],
  "sideEffects": [
    "./dist/hubzz-ui.css",
    "./dist/assets/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('dist/index.d.ts', 'dist/index.d.cts')\" && pnpm generate:manifest",
    "build:preview": "tsc -b && VITE_APP_BUILD=preview vite build",
    "build:vercel": "tsc -b && VITE_APP_BUILD=vercel vite build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm workflow:actions:check && pnpm registry:graph:test && pnpm package:deps:check && pnpm manifest:check && pnpm registry:sync:check && pnpm build:preview && pnpm build:vercel && pnpm build && pnpm registry:validate && pnpm pack:check && pnpm package:smoke",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "generate:manifest": "tsx scripts/generate-manifest.ts",
    "lint": "eslint . --max-warnings=0",
    "manifest:check": "tsx scripts/generate-manifest.ts --check",
    "package:deps:check": "tsx scripts/check-package-boundary.ts",
    "package:smoke": "bash scripts/smoke-package-consumer.sh",
    "pack:check": "publint",
    "preview": "vite preview",
    "registry:graph:test": "node --import tsx --test scripts/registry-graph.test.ts",
    "registry:list": "shadcn list russfranky/hubzzcn",
    "registry:smoke": "bash scripts/smoke-registry-consumer.sh",
    "registry:sync": "tsx scripts/sync-foundations-registry.ts",
    "registry:sync:check": "tsx scripts/sync-foundations-registry.ts --check",
    "registry:validate": "shadcn registry validate",
    "registry:view": "shadcn view russfranky/hubzzcn/hubzz",
    "release:pin-registry": "tsx scripts/release-registry-refs.ts pin",
    "release:verify-registry": "tsx scripts/release-registry-refs.ts verify",
    "test": "pnpm test:ui",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit",
    "workflow:actions:check": "node scripts/check-workflow-action-pins.mjs",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@hookform/resolvers": "^5.2.2",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "publint": "^0.3.16",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.72.0",
    "shadcn": "^4.1.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "zod": "^4.3.6"
  }
}
